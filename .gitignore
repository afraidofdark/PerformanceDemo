# Build output, publish bundles and generated packs. Rebuild with CMake plus the Packer;
# nothing below is a source file.
/Intermediate/
/Codes/Intermediate/
/Codes/Bin/
/Publish/
/MinResources.pak
/MinResources.pak.old
/MinResources.pak.hash
/TkAndroidBuild/

# Android build state (NDK/CMake work dirs, Gradle caches, the packed asset copy).
/Android/.gradle/
/Android/.idea/
/Android/app/build/
/Android/app/.cxx/
/Android/local.properties
/Android/app/src/main/assets/MinResources.pak
/Android/app/src/main/assets/MinResources.pak.hash

# Tooling and editor state.
.vs/
/out/
*.user
*.suo
Log.txt
Assimplog.txt

# Streamline captures. The raw .apc folders are ~10 MB each (a data series plus a 2.4 MB
# events.xml per capture) and are regenerated by the recipe in PerfAnalysis/streamline/README.md;
# what is kept in the repo are the reports the CLI writes from them.
/PerfAnalysis/streamline/*.apc/
